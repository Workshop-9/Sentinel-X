# Copier ce fichier en .env (jamais commité) puis remplir.
# Commande PowerShell :  Copy-Item .env.example .env

# Compte MQTT de l'IA (fourni par INFRA/CYBER)
SENTINEL_MQTT_USER=
SENTINEL_MQTT_PASS=

# Jeton du flux vidéo (optionnel) : si défini, http://...:8081/video?token=<jeton>
# Générer : python -c "import secrets; print(secrets.token_urlsafe(24))"
SENTINEL_STREAM_TOKEN=

# Surcharges facultatives de config/settings.toml
# SENTINEL_MQTT_HOST=192.168.137.1
# SENTINEL_MQTT_PORT=8883
# SENTINEL_MQTT_TLS=true
# SENTINEL_HOME=C:\Users\ordi\sentinel_x
